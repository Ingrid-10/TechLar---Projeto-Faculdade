ter;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fillColor=#E8F7EF;strokeColor=#26734D;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="720" width="290" height="155" as="geometry" /></mxCell><mxCell id="contato" value="&lt;div style='font-size:16px'&gt;&lt;b&gt;Contact&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left'&gt;+ AccountId: Lookup&lt;br&gt;+ FirstName / LastName&lt;br&gt;+ CPF__c: Text&lt;br&gt;+ Email / Phone&lt;br&gt;+ MailingAddress&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fillColor=#E8F7EF;strokeColor=#26734D;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="930" width="290" height="170" as="geometry" /></mxCell><mxCell id="pedido" value="&lt;div style='font-size:16px'&gt;&lt;b&gt;Order&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left'&gt;+ OrderNumber: Auto Number&lt;br&gt;+ Status&lt;br&gt;+ EffectiveDate&lt;br&gt;+ Loja__c: Lookup&lt;br&gt;+ CanalVenda__c: Picklist&lt;br&gt;+ ModalidadeRecebimento__c&lt;br&gt;+ ValorFrete__c / PrazoEntregaDias__c&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fillColor=#E8F2FF;strokeColor=#1B5FAA;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="700" width="340" height="220" as="geometry" /></mxCell><mxCell id="item" value="&lt;div style='font-size:16px'&gt;&lt;b&gt;OrderItem&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left'&gt;+ OrderId: Lookup&lt;br&gt;+ Product2Id: Lookup&lt;br&gt;+ Quantity: Number&lt;br&gt;+ UnitPrice: Currency&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fillColor=#E8F2FF;strokeColor=#1B5FAA;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="720" width="300" height="155" as="geometry" /></mxCell><mxCell id="caso" value="&lt;div style='font-size:16px'&gt;&lt;b&gt;Case&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style='text-align:left'&gt;+ CaseNumber: Auto Number&lt;br&gt;+ AccountId: Lookup&lt;br&gt;+ Status / Priority&lt;br&gt;+ MotivoPosVenda__c&lt;br&gt;+ ResultadoAtendimento__c&lt;br&gt;+ Pedido__c / PedidoItem__c&lt;br&gt;+ Produto__c: Lookup&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=8;spacingLeft=8;spacingRight=8;fillColor=#F2ECFF;strokeColor=#6345A5;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="690" width="330" height="220" as="geometry" /></mxCell><mxCell id="nota-estoque" value="&lt;b&gt;Regras implementadas&lt;/b&gt;&lt;br&gt;Transferência manual: Pedido feito →&lt;br&gt;Em transporte → Concluída.&lt;br&gt;A entrada só aumenta o destino&lt;br&gt;quando o recebimento é confirmado." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#F5F6F8;strokeColor=#44546A;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="330" height="145" as="geometry" /></mxCell><mxCell id="nota-agent" value="&lt;b&gt;Reposição Agentforce&lt;/b&gt;&lt;br&gt;Analisa Top 3 por loja em 30 dias.&lt;br&gt;Abaixo de 5, repõe até 10.&lt;br&gt;Origem: Estoque Central.&lt;br&gt;Sem transferência parcial." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF7E6;strokeColor=#9A5D00;fontColor=#172033;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="340" width="330" height="135" as="geometry" /></mxCell><mxCell id="e1" value="1 loja — 0..* saldos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#667085;strokeWidth=1.4;endArrow=none;dashed=0;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="loja" target="estoque"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="205" /></Array></mxGe